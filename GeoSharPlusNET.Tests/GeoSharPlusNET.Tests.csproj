<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!--
      xunit.v3.mtp-off is xunit.v3 without Microsoft Testing Platform (MTP).
      With MTP, "dotnet test" in VSTest mode stops with an error on .NET SDK 10 and later.
      This package runs the tests through VSTest on SDK 8, 9 and 10.
    -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
  </ItemGroup>

  <!-- 
    Note: We don't reference GeoSharPlusNET directly because it has RhinoCommon dependency.
    Instead, we compile the Core and Geometry files directly for testing.
  -->
  <ItemGroup>
    <!-- Include Core classes -->
    <Compile Include="..\GeoSharPlusNET\Core\*.cs">
      <Link>Core\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Include Geometry classes -->
    <Compile Include="..\GeoSharPlusNET\Geometry\*.cs">
      <Link>Geometry\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Include generated FlatBuffer types -->
    <Compile Include="..\generated\GSP_FB\csharp\**\*.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
