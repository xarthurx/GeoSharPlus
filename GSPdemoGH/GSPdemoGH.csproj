<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Select the framework(s) you wish to target.
        Rhino 8 Windows: net48, net8.0, net8.0-windows, net8.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net8.0, net8.0-macos, net8.0-macos12.0, etc
    -->
		<TargetFrameworks>net8.0</TargetFrameworks>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.gha</TargetExt>
		<NoWarn>NU1701;NETSDK1086</NoWarn>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Specifies information for Assembly and Yak -->
		<Version>1.0</Version>
		<Title>GSPdemoGH</Title>
		<Company>GSPdemoGH Authors</Company>
		<Description>Description of GSPdemoGH</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Explicitly reference RhinoCommon to resolve version conflict with GeoSharPlusNET -->
		<PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
		<PackageReference Include="Grasshopper" Version="8.21.25188.17001" ExcludeAssets="runtime" />
	</ItemGroup>

	<!-- For Windows only builds -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!-- Reference WinForms for .NET 8.0 on macOS -->
	<ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
		<!-- Rhino 8.11 and later you can use this -->
		<!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->

		<!-- Rhino 8.10 and earlier -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
		<Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.34" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\GeoSharPlusNET\GeoSharPlusNET.csproj" />
	</ItemGroup>

	<!--
		Copy the native C++ library from <repo>/cppPrebuild to the build output.
		CMake writes the library to cppPrebuild after each C++ build.
		The target uses MSBuild tasks only, so it runs on Windows and macOS without PowerShell.
		It does not use $(SolutionDir), which is undefined when you build this project without the .sln.
	-->
	<PropertyGroup>
		<GspCppPrebuildDir>$(MSBuildThisFileDirectory)../cppPrebuild/</GspCppPrebuildDir>
	</PropertyGroup>
	<Target Name="GspCopyNativeLibrary" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
		<ItemGroup>
			<GspNativeLibrary Include="$(GspCppPrebuildDir)*.dll;$(GspCppPrebuildDir)*.dylib;$(GspCppPrebuildDir)*.so" />
		</ItemGroup>
		<Warning Condition="'@(GspNativeLibrary)' == ''" Text="No native library found in $(GspCppPrebuildDir). Build GeoSharPlusCPP with CMake first." />
		<Copy SourceFiles="@(GspNativeLibrary)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
	</Target>

	<!-- Collect the plugin and its libraries in <repo>/bin/<target framework>/ -->
	<Target Name="GspCopyToRepoBin" AfterTargets="GspCopyNativeLibrary" Condition="'$(TargetFramework)' != ''">
		<ItemGroup>
			<GspPluginFile Include="$(TargetDir)*.gha;$(TargetDir)*.dll;$(TargetDir)*.dylib;$(TargetDir)*.so" />
		</ItemGroup>
		<Copy SourceFiles="@(GspPluginFile)" DestinationFolder="$(MSBuildThisFileDirectory)../bin/$(TargetFramework)/" SkipUnchangedFiles="true" />
	</Target>

</Project>