<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
		<PackageReference Include="RhinoCommon" Version="8.21.25188.17001" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\generated\GSP_FB\csharp\**\*.cs">
			<Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
	  <!-- CMake writes this project only with a Visual Studio generator. The Ninja presets do not. -->
	  <ProjectReference Include="..\GeoSharPlusCPP\build\GeoSharPlusCPP.vcxproj" Condition="Exists('..\GeoSharPlusCPP\build\GeoSharPlusCPP.vcxproj')" />
	</ItemGroup>

</Project>
